@model IEnumerable<VDCD.Entities.Custom.JobPosition>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var activeJobs = Model
        .Where(x => x.IsActive == true)
        .ToList();
}

@functions {
    string GetSt(string key) => ViewBag.Settings.ContainsKey(key) ? ViewBag.Settings[key] : "";
}

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script>
    $(document).ready(function () {
        $.ajax({
            url: '/home/GetHeader',
            type: 'GET',
            success: function (response) {
                if (response.success) {
                    const logoData = response.footer.find(item => item.settingKey === "setting.general.footer.logo");
                    if (logoData) {
                        $('#main-logo').attr('src', logoData.value);
                    }
                }
            },
            error: function (err) {
                console.error("Không thể lấy dữ liệu từ API", err);
            }
        });
    });
</script>

<div class="container py-5" style="margin-top: 110px;">
    <h2 data-aos="fade-down" data-aos-duration="1500" class="text-center mb-5 fw-bold">Cơ hội nghề nghiệp</h2>

    <!-- Bộ lọc (tự động, không cần nút) -->
    <div class="row g-3 mb-4 p-3 bg-light rounded shadow-sm">
        <div class="col-md-3">
            <label class="form-label fw-semibold">Ngành nghề</label>
            <select id="filterIndustry" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var industry in activeJobs
                    .Select(x => x.Industry)
                    .Where(x => !string.IsNullOrEmpty(x))
                    .Distinct()
                    .OrderBy(x => x))
                {
                    <option value="@industry">@industry</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Cấp bậc</label>
            <select id="filterLevel" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var level in activeJobs
                    .Select(x => x.Level)
                    .Where(x => !string.IsNullOrEmpty(x))
                    .Distinct()
                    .OrderBy(x => x))
                {
                    <option value="@level">@level</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Loại hình</label>
            <select id="filterEmploymentType" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var type in activeJobs
                    .Select(x => x.EmploymentType)
                    .Where(x => !string.IsNullOrEmpty(x))
                    .Distinct()
                    .OrderBy(x => x))
                {
                    <option value="@type">@type</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold">Địa điểm</label>
            <select id="filterLocation" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var loc in activeJobs
                    .Select(x => x.Location)
                    .Where(x => !string.IsNullOrEmpty(x))
                    .Distinct()
                    .OrderBy(x => x))
                {
                    <option value="@loc">@loc</option>
                }
            </select>
        </div>
    </div>

    <div class="row g-4" id="job-list">
        @foreach (var job in activeJobs)
        {
            <div class="col-md-6 col-lg-4 job-item"
                 data-industry="@job.Industry"
                 data-level="@job.Level"
                 data-employmenttype="@job.EmploymentType"
                 data-location="@job.Location"
                 data-aos="fade-right" data-aos-duration="1500">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <span class="badge bg-light text-primary mb-2">@job.EmploymentType</span>
                        <h5 class="card-title fw-bold">@job.Title</h5>
                        <p class="text-muted small"><i class="bi bi-geo-alt"></i> @job.Location</p>
                        <p class="card-text text-truncate">@System.Text.RegularExpressions.Regex.Replace(job.Description ?? "", "<.*?>", string.Empty)</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 pb-3">
                        <a href="/tuyen-dung/@job.Slug" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <nav class="mt-5">
        <ul class="pagination justify-content-center" id="pagination"></ul>
    </nav>
</div>

<script>
    const pageSize = 6;
    const items = document.querySelectorAll('.job-item');
    const paginationElement = document.getElementById('pagination');
    let currentPage = 1;

    // Hàm lọc (dựa trên giá trị các select)
    function filterJobs() {
        const industry = $('#filterIndustry').val();
        const level = $('#filterLevel').val();
        const empType = $('#filterEmploymentType').val();
        const location = $('#filterLocation').val();

        // Duyệt từng item và đánh dấu filtered-out
        $('.job-item').each(function () {
            const $item = $(this);
            const matchIndustry = !industry || $item.data('industry') === industry;
            const matchLevel = !level || $item.data('level') === level;
            const matchEmpType = !empType || $item.data('employmenttype') === empType;
            const matchLocation = !location || $item.data('location') === location;

            if (matchIndustry && matchLevel && matchEmpType && matchLocation) {
                $item.removeClass('filtered-out');
            } else {
                $item.addClass('filtered-out');
            }
        });

        // Reset về trang 1 và cập nhật phân trang
        currentPage = 1;
        updatePaginationAndDisplay();
    }

    // Cập nhật phân trang và hiển thị dựa trên các item không bị lọc
    function updatePaginationAndDisplay() {
        const visibleItems = Array.from(items).filter(item => !item.classList.contains('filtered-out'));
        const totalPages = Math.ceil(visibleItems.length / pageSize);
        if (currentPage > totalPages) currentPage = totalPages || 1;

        // Ẩn hết tất cả item
        items.forEach(item => item.classList.add('d-none'));

        // Hiện item thuộc trang hiện tại
        const start = (currentPage - 1) * pageSize;
        const end = start + pageSize;
        visibleItems.forEach((item, idx) => {
            if (idx >= start && idx < end) {
                item.classList.remove('d-none');
            }
        });

        // Vẽ lại phân trang
        paginationElement.innerHTML = '';
        if (totalPages <= 1) return;

        for (let i = 1; i <= totalPages; i++) {
            const li = document.createElement('li');
            li.className = `page-item ${i === currentPage ? 'active' : ''}`;
            li.innerHTML = `<button class="page-link" onclick="goToPage(${i})">${i}</button>`;
            paginationElement.appendChild(li);
        }
    }

    // Hàm chuyển trang
    function goToPage(page) {
        currentPage = page;
        updatePaginationAndDisplay();
    }

    // Gắn sự kiện change cho các select (lọc tự động)
    $(document).ready(function () {
        $('#filterIndustry, #filterLevel, #filterEmploymentType, #filterLocation').on('change', function () {
            filterJobs();
        });

        // Ẩn tất cả item ban đầu, sau đó hiện trang đầu
        $('.job-item').addClass('d-none');
        filterJobs(); // chạy lọc lần đầu (hiện tất cả)
    });
</script>

<style>
    .job-item {
        transition: opacity 0.4s ease-in-out;
    }

    .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }

    .page-link {
        cursor: pointer;
        border-radius: 8px !important;
        margin: 0 3px;
    }
</style>