<style>
    .header-logo {
        max-width: 100%;
        height: auto;
        max-height: 60px; /* Chiều cao tối đa trên desktop */
        width: auto;
    }

    .hero-slider {
        position: relative;
        width: 100%;
        height: 100vh;
        min-height: 400px;
        overflow: hidden;
        margin-top: 45px;
    }

    /* Hiệu ứng Zoom nhẹ cho ảnh nền */
    .carousel-item {
        height: 100vh;
        min-height: 400px;
        background-color: #000;
    }

    @@media (max-width: 768px) {
        .hero-slider,
        .carousel-item {
            height: 70vh;
            min-height: 320px;
        }
    }

    @@media (max-width: 480px) {
        .hero-slider,
        .carousel-item {
            height: 60vh;
            min-height: 280px;
            margin-top: 0;
        }

        .navbar-dark .navbar-brand {
            width: 70% !important;
        }
    }

    .zoom-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    display: block;
        transition: transform 6s ease-out; /* Thời gian zoom */
        transform: scale(1);
    }

   .section-line {
    width: 30px;
    height: 2px;
    background-color: #e30613;
    display: inline-block;
}

    /* Khi slide active, thực hiện zoom lên 1.1 */
    .carousel-item.active .zoom-bg {
        @* transform: scale(1.15); *@
        animation: kenBurnsLeft 10s ease-in-out infinite alternate;
    }

    .carousel-item.active .zoom-bg.restart-animation {
    animation: none;
}

     @@keyframes kenBurnsLeft {
        0% {
            /* Bắt đầu ở vị trí trung tâm, tỉ lệ 1:1 */
            transform: scale(1) translate(0, 0);
        }
        100% {
            /* scale(1.1): Phóng to 10% 
            translate(-10%, 0): Dịch sang TRÁI 10% chiều rộng của chính nó
            */
            transform: scale(1.2) translate(-5%, 0);
        }
    }

    /* Overlay tối để nổi bật chữ */
    .carousel-item::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 70%; 
    background: linear-gradient(
        to top, 
        rgba(0, 0, 0, 0.9) 0%, 
        rgba(0, 0, 0, 0.5) 60%, 
        rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
}

    /* Căn chỉnh chữ - đã được định nghĩa ở block style trên */
    .custom-caption {
        text-align: left;
        left: 0 !important;
        right: 0 !important;
        bottom: 20%;
        z-index: 10;
    }

    .hero-title {
        font-size: clamp(28px, 6vw, 60px) !important;
        font-weight: 900;
        color: #fff;
        margin: 0 5% 0 5%;
        line-height: 1.1;
    }

    @* .hero-subtitle {
        font-size: 60px;
        font-weight: 800;
        color: #fff;
        letter-spacing: 2px;
    } *@

    .text-red {
        color: #ff0000;
    }

    /* Nút Khám phá dự án */
    .explore-button-wrapper {
        position: absolute;
        bottom: 100px;
        left: calc(50% - 120px);
        right: auto;
        width: auto;
        z-index: 20;
        text-align: left;
    }

    @@media (max-width: 768px) {
        .explore-button-wrapper {
            right: auto;
            left: calc(50% - 120px);
            bottom: 90px;
            width: auto;
        }
        .custom-caption {
            bottom: 15%;
        }
    }

    @@media (max-width: 480px) {
        .hero-title {
            margin: 0 2% 0 2%;
        }
        .explore-button-wrapper {
            bottom: 100px;
            left: 85px;
        }
    }

    .btn-explore {
        font-size: 18px;
        border: 1px solid #fff;
        color: #fff;
        padding: 10px 25px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: bold;
        display: flex;
        align-items: center;
        transition: 0.3s;
        background: rgba(0,0,0,0.3);
        display: ruby;
    }

    .icon-arrow {
        background: #ff0000;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: 15px;
    }

    .btn-explore:hover {
        background: #fff;
        color: #000;
    }

    /* Indicators tùy chỉnh */
    .custom-indicators {
        @* justify-content: flex-start;
        left: 10%; *@
        margin-bottom: 50px;
    }

        .custom-indicators [data-bs-target] {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #fff;
            border: none;
            margin-right: 10px;
        }

        /* =========================
   DROPDOWN MENU DESKTOP + MOBILE
========================= */

.navbar .dropdown {
    position: relative;
}

/* Dropdown mặc định */
.dropdown-menu {
    background: #000;
    border: none;
    border-radius: 14px;
    padding: 10px 0;
    min-width: 260px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
}

/* Item */
.dropdown-item {
    color: #fff !important;
    font-family: "Lora", sans-serif;
    font-size: 15px;
    font-weight: 600;
    padding: 14px 22px;
    transition: all 0.25s ease;
}

.dropdown-item:hover {
    background: rgba(255, 0, 0, 0.12);
    color: #ff0000 !important;
    padding-left: 28px;
}

/* Icon dropdown */
.navbar .dropdown-toggle::after {
    margin-left: 8px;
    vertical-align: middle;
}

/* =========================
   DESKTOP
========================= */
@@media (min-width: 992px) {

    .navbar .dropdown-menu {
        display: block;
        opacity: 0;
        visibility: hidden;
        transform: translateY(12px);
        transition:
            opacity 0.25s ease,
            transform 0.25s ease,
            visibility 0.25s;
        pointer-events: none;
    }

    .navbar .dropdown:hover .dropdown-menu {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto;
    }
}

/* =========================
   MOBILE
========================= */
@@media (max-width: 991.98px) {

    .navbar-collapse {
        background: #000;
        padding: 15px 0;
    }

    .dropdown-menu {
        position: static !important;
        transform: none !important;
        opacity: 1 !important;
        visibility: visible !important;
        display: none;
        width: 100%;
        margin-top: 8px;
        background: rgba(255,255,255,0.03);
        border-radius: 10px;
        box-shadow: none;
        padding: 0;
    }

    /* Hover mobile/tablet */
    .navbar .dropdown:hover .dropdown-menu,
    .navbar .dropdown:focus-within .dropdown-menu {
        display: block;
    }

    .dropdown-item {
        padding: 14px 18px 14px 30px;
        font-size: 14px;
    }

    .dropdown-item:hover {
        padding-left: 36px;
    }
}
</style>

<script>
    // Load logo một lần duy nhất tại đây — không cần lặp lại ở từng view
    document.addEventListener('DOMContentLoaded', function () {
        fetch('/home/GetHeader')
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res.success) return;
                var logoItem = res.footer.find(function (x) { return x.settingKey === 'setting.general.footer.logo'; });
                if (logoItem) {
                    var el = document.getElementById('main-logo');
                    if (el) el.src = logoItem.value;
                }
                // Expose toàn bộ response để các view khác dùng nếu cần (slider, v.v.)
                window.__headerData = res;
                document.dispatchEvent(new CustomEvent('headerLoaded', { detail: res }));
            })
            .catch(function (e) { console.warn('GetHeader failed', e); });
    });
</script>
