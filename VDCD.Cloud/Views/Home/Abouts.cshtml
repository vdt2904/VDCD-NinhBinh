        max-height: 120px; /* Tang l�n 90px ho?c 100px n?u b?n th?y v?n b� */
        max-width: 100%;
        width: auto;
        object-fit: contain;
        display: block;
    }

    /* �?m b?o kho?ng c�ch gi?a c�c logo trong slider tho�ng hon */
    .customer-slider .px-4 {
        padding-left: 25px !important;
        padding-right: 25px !important;
    }
</style>