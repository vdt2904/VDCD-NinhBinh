@model VDCD.Models.HomeModelView
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    string GetSt(string key) => Model.Settings.ContainsKey(key) ? Model.Settings[key] : "";
}
<section class="hero-section d-flex align-items-end">
    <div class="container-fluid px-0">
        <div class="hero-content text-white p-5">

            <h1 data-aos="fade-right" data-aos-duration="600" class="display-3 fw-bold mb-0">@ViewData["Title"]</h1>
            <hr class="border-light opacity-50 mb-4" style="width:90%">
            <nav data-aos="fade-right" data-aos-duration="600" aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/" class="text-white text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active text-white fw-light" aria-current="page">Về chúng tôi</li>
                </ol>
            </nav>

        </div>
    </div>
</section>
<style>
    .hero-section {
        /* Thay du?ng d?n ?nh c?a b?n v�o d�y */
        background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url('/uploads/dcc316a8-6f43-421b-825d-afbf055b652c_slice1.jpg');
        background-size: cover;
        background-position: center;
        height: 700px; /* �i?u ch?nh chi?u cao t�y � */
        position: relative;
        display: flex;
        align-items: flex-end; /* �?y n?i dung xu?ng d�y */
        margin-top: 45px;
    }

    .hero-content {
        width: 100%;
        background: linear-gradient(transparent, rgba(0,0,0,0.4)); /* L�m t?i nh? ph?n ch�n ch? */
        padding-bottom: 60px !important;
        padding-left: 10% !important;
    }

    .breadcrumb-item + .breadcrumb-item::before {
        content: ">";
        color: white;
    }

    .hero-content h1 {
        @* font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; *@
        letter-spacing: -1px;
    }

    /* Responsive cho mobile */
    @@media (max-width: 768px) {
        .hero-section {
            height: 350px;
        }

        .hero-content h1 {
            font-size: 2.5rem;
        }
    }
</style>

<section class="brand-story py-5" style="background-color: #fff;">
    <div class="container">
        <div class="row mb-5">
            <div class="col-12 text-center">
                <div data-aos="fade-down" data-aos-duration="600" class="text-danger text-uppercase fw-bold mb-4" style="letter-spacing: 2px;">
                    <span class="border-top border-danger border-3 me-2" style="width: 30px; display: inline-block; vertical-align: middle;"></span>
                    <span class="small">Câu chuyện thương hiệu</span>
                    <span class="border-top border-danger border-3 ms-2" style="width: 30px; display: inline-block; vertical-align: middle;"></span>
                </div>
                <h2 data-aos="fade-down" data-aos-duration="1500" class="display-6 fw-bold text-uppercase">VDCD NINH BÌNH</h2>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-6" data-aos="fade-right" data-aos-duration="600">
                <div class="position-relative">
                    <img src="@GetSt("setting.general.trademark.image")" alt="VDCD Projects Map" class="img-fluid w-100 shadow-sm rounded" loading="lazy" width="600" height="400">
                </div>
            </div>

            <div class="col-lg-6" data-aos="fade-left" data-aos-duration="600">
                <div class="brand-info">
                    <h4 class="text-danger fw-bold mb-3" style="line-height: 1.2;">
                        @GetSt("setting.general.footer.namecompany")
                    </h4>

                    <div class="mb-4">
                        <p class="mb-1"><strong>Tên viết tắt:</strong> @GetSt("setting.general.trademark.initials")</p>
                        <p><strong>Giấy chứng nhận đăng ký kinh doanh số:</strong> @GetSt("setting.general.trademark.tax")</p>
                    </div>
                        
                    <div class="description-text text-muted" style="text-align: justify; line-height: 1.8;">
                        <p>@Html.Raw(GetSt("setting.general.trademark.description").Replace("\n", "<br />"))</p>

                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* T�y ch?nh th�m d? gi?ng h?t thi?t k? */
    .fw-black {
        font-weight: 900;
    }

    @* .brand-story {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    } *@

    .text-danger {
        color: #e31e24 !important; /* M�u d? d?c trung c?a thuong hi?u */
    }
</style>

<style>
    /* T?ng th? ph?n Th? m?nh */
    .strengths-section {
        background-color: #f8f9fa;
        padding: 80px 0;
        @* font-family: 'Segoe UI', Arial, sans-serif; *@
    }

    .section-subtitle {
        color: #e31e24;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        align-items: center;
    }

        .section-subtitle::before {
            content: "";
            display: inline-block;
            width: 30px;
            height: 2px;
            background-color: #e31e24;
            margin-right: 10px;
        }

    /* Tinh ch?nh th? Card */
    .strengths-carousel .slick-list {
        padding: 20px 0; /* T?o kh�ng gian cho hi?u ?ng hover nh�ch l�n */
    }

    .card-strength {
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 4px;
        padding: 40px 30px;
        margin: 0 10px;
        transition: all 0.3s ease;
        display: flex !important;
        flex-direction: column;
        height: 450px; /* �? cao c? d?nh d? c�c slide d?u nhau */
        position: relative;
        box-shadow: 0 5px 15px rgba(0,0,0,0.02);
    }

        /* Hi?u ?ng Hover: Hi?n d?i d? ? d�y v� nh�ch l�n */
        .card-strength:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
            border-bottom: 4px solid #e31e24 !important;
        }
        .card-strength:hover .strength-number {
            transition: all 0.3s ease;
            background: #f00;
            color: #fff;
            border: none;
        }

    .strength-number {
        font-size: 0.8rem;
        font-weight: 600;
        color: #888;
        border: 1px solid #ddd;
        padding: 2px 8px;
        border-radius: 3px;
        width: fit-content;
        margin-bottom: 25px;
    }

    .strength-title {
        font-weight: 700;
        font-size: 1.6rem;
        color: #111;
        margin-bottom: 20px;
    }

    /* X? l� n?i dung c� xu?ng d�ng t? Database */
    .strength-description {
        white-space: pre-line; /* Quan tr?ng nh?t d? nh?n di?n Enter */
        color: #666;
        font-size: 0.95rem;
        line-height: 1.7;
        text-align: justify;
        display: -webkit-box;
        -webkit-line-clamp: 12;      /* s? d�ng mu?n hi?n th? */
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .strength-description:hover {
        -webkit-line-clamp: unset;
        overflow: auto;
    }

    /* Custom n�t di?u hu?ng Carousel */
    .slick-prev:before, .slick-next:before {
        color: #e31e24;
        font-size: 24px;
    }

    .slick-dots li.slick-active button:before {
        color: #e31e24;
    }
</style>

<section class="strengths-section overflow-hidden">
    <div class="container">
        <div class="row mb-5 align-items-center">
            <div data-aos="fade-down" data-aos-duration="600" class="col-lg-3">
                <div class="text-danger text-uppercase fw-bold" style="letter-spacing: 2px;">
                <span class="border-top border-danger border-3 me-2" style="width: 30px; display: inline-block; vertical-align: middle;"></span>
                <span class="small">Thế mạnh</span>
                <span class="border-top border-danger border-3 ms-2" style="width: 30px; display: inline-block; vertical-align: middle;"></span>
                </div>
            </div>
            <div data-aos="fade-down" data-aos-duration="600" class="col-lg-9">
                <p class="mb-0 fw-bold text-muted" style="max-width: 800px;">
                    VDCD sở hữu công nghệ lõi và đội ngũ nhân sự là chuyên gia hàng đầu trong lĩnh vực chuyển đổi số,
                    xử lý dữ liệu theo chuẩn mô hình BIM & GIS và phát triển hệ thống phần mềm chuyên biệt.
                </p>
            </div>
        </div>

        <div class="strengths-carousel">
            @{
                int i = 0;
                // V�ng l?p qu�t to�n b? d? li?u t? setting.general.vision
                while (Model.Settings.ContainsKey($"setting.general.vision.tab_name.{i}"))
                {
                    var tabName = GetSt($"setting.general.vision.tab_name.{i}");
                    var content = GetSt($"setting.general.vision.content.{i}");

                    if (!string.IsNullOrEmpty(tabName))
                    {
                        <div class="slide-item" data-aos="fade-right" data-aos-duration="600">
                            <div class="card-strength">
                                <div class="strength-number">
                                    @(i + 1 < 10 ? "0" + (i + 1) : (i + 1).ToString()).
                                </div>
                                <h3 class="strength-title">@tabName</h3>
                                <div class="strength-description">
                                    @content
                                </div>
                            </div>
                        </div>
                    }
                    i++;
                }
            }
        </div>
    </div>
</section>


<script>
    document.addEventListener('DOMContentLoaded', function () {
        $('.strengths-carousel').slick({
            dots: false,
            infinite: false,
            speed: 500,
            slidesToShow: 4,
            slidesToScroll: 1,
            autoplay: true,
            autoplaySpeed: 5000,
            responsive: [
                { breakpoint: 1200, settings: { slidesToShow: 3 } },
                { breakpoint: 992, settings: { slidesToShow: 2 } },
                { breakpoint: 768, settings: { slidesToShow: 1 } }
            ]
        });
    });
</script>

<style>
    .solutions-section {
        padding: 80px 0;
        background-color: #fff;
    }

    .main-title {
        font-size: 2.5rem;
        text-align: center;
        margin-bottom: 40px;
        color: #000;
        letter-spacing: -1px;
        text-transform: uppercase;
        font-weight: 700;
    }

    /* Slide card layout */
    .solution-slide-card {
        display: flex !important;
        flex-direction: row;
        align-items: stretch;
        gap: 0;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 6px;
        overflow: hidden;
        margin: 0 15px;
        min-height: 420px;
    }

    .solution-slide-left {
        flex: 0 0 45%;
        padding: 40px 35px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    .solution-slide-right {
        flex: 0 0 55%;
        position: relative;
        overflow: hidden;
        min-height: 350px;
    }

    .solution-slide-right img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.6s ease;
    }

    .solution-slide-card:hover .solution-slide-right img {
        transform: scale(1.05);
    }

    .solution-column-title {
        font-weight: 700;
        font-size: 1.6rem;
        margin-bottom: 24px;
        color: #000;
        line-height: 1.3;
    }

    .solution-list-container p {
        position: relative;
        padding-left: 18px;
        margin-bottom: 10px;
        font-size: 0.95rem;
        color: #444;
        line-height: 1.6;
        text-align: justify;
    }

    .solution-list-container p::before {
        content: "�";
        color: #e31e24;
        font-weight: bold;
        position: absolute;
        left: 0;
        font-size: 1.1rem;
        line-height: 1.5;
    }

    /* Slider nav buttons */
    .solutions-nav {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 30px;
    }

    .solutions-nav button {
        width: 48px;
        height: 48px;
        border: 2px solid #333;
        background: transparent;
        border-radius: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1rem;
        color: #333;
    }

    .solutions-nav button:hover {
        background: #e31e24;
        border-color: #e31e24;
        color: #fff;
    }

    /* Responsive */
    @@media (max-width: 991.98px) {
        .solution-slide-card {
            flex-direction: column;
            margin: 0 10px;
            min-height: unset;
        }

        .solution-slide-left {
            flex: unset;
            padding: 30px 25px;
        }

        .solution-slide-right {
            flex: unset;
            min-height: 250px;
        }

        .solution-column-title {
            font-size: 1.3rem;
        }
    }

    @@media (max-width: 575.98px) {
        .solution-slide-right {
            min-height: 200px;
        }

        .solution-slide-left {
            padding: 24px 20px;
        }

        .solution-column-title {
            font-size: 1.2rem;
            margin-bottom: 16px;
        }
    }
</style>

<section class="solutions-section overflow-hidden">
    <div class="container">
        <div class="d-flex justify-content-center mb-4">
            <h5 data-aos="fade-down" data-aos-duration="600" class="text-danger text-uppercase fw-bold" style="letter-spacing: 2px;">
                <span class="border-top border-danger border-3 me-2" style="width: 30px; display: inline-block; vertical-align: middle;"></span>
                <span class="small">Giải pháp</span>
                <span class="border-top border-danger border-3 ms-2" style="width: 30px; display: inline-block; vertical-align: middle;"></span>
            </h5>
        </div>

        <h2 data-aos="fade-down" data-aos-duration="1500" class="main-title">Lĩnh vực hoạt động</h2>

        <div class="solutions-slider" data-aos="fade-up" data-aos-duration="600">
            @{
                int i1 = 0;
                while (Model.Settings.ContainsKey($"setting.general.solution.title.{i1}"))
                {
                    var title = GetSt($"setting.general.solution.title.{i1}");
                    var content = GetSt($"setting.general.solution.content.{i1}");
                    var image = GetSt($"setting.general.solution.image.{i1}");
                    if (string.IsNullOrEmpty(image)) image = "/images/default.png";

                    <div>
                        <div class="solution-slide-card">
                            <div class="solution-slide-left">
                                <h3 class="solution-column-title">@title</h3>
                                <div class="solution-list-container">
                                    @if (!string.IsNullOrEmpty(content))
                                    {
                                        var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);
                                        foreach (var line in lines)
                                        {
                                            <p>@line.Trim()</p>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="solution-slide-right">
                                <img src="@image" alt="@title" loading="lazy" width="600" height="420">
                            </div>
                        </div>
                    </div>
                    i1++;
                }
            }
        </div>

        <div class="solutions-nav">
            <button id="prevSolution" aria-label="Previous">
                <i class="fa-solid fa-arrow-left"></i>
            </button>
            <button id="nextSolution" aria-label="Next">
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>
    </div>
</section>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        $('.solutions-slider').slick({
            dots: false,
            infinite: true,
            speed: 600,
            slidesToShow: 1,
            slidesToScroll: 1,
            autoplay: true,
            autoplaySpeed: 5000,
            arrows: false,
            adaptiveHeight: true
        });
        document.getElementById('prevSolution').addEventListener('click', function () {
            $('.solutions-slider').slick('slickPrev');
        });
        document.getElementById('nextSolution').addEventListener('click', function () {
            $('.solutions-slider').slick('slickNext');
        });
    });
</script>
<section class="partners-section py-5 bg-light overflow-hidden">
    <div class="container">
        <div class="row mb-4 justify-content-center align-items-center">
            <div class="col-md-auto">
                <h5 data-aos="fade-down" data-aos-duration="1500" class="d-flex justify-content-center align-items-center">
					<span class="line me-2" style="width: 30px; height: 2px; background-color: #e30613; display: inline-block;"></span>
					<span class="text-danger fw-bold text-uppercase" style="white-space: nowrap;">khách hàng & đối tác</span>
					<span class="line ms-2" style="width: 30px; height: 2px; background-color: #e30613; display: inline-block;"></span>
				</h5>
            </div>
            @* <div class="col border-top border-secondary-subtle ms-3 d-none d-md-block">
            </div> *@
        </div>

        <div class="row">
            <div class="col-12">
                <div class="customer-slider">
                    @foreach (var item in Model.Customers)
                    {
                        <div class="px-4" data-aos="fade-right" data-aos-duration="600">
                            <div class="partner-logo-wrapper d-flex align-items-center justify-content-center">
                                <img data-lazy="@item.Image"
                                     alt="@item.CustomerName"
                                     title="@item.CustomerName"
                                     class="img-fluid partner-logo"
                                     loading="lazy"
                                     width="160" height="90">
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        $('.customer-slider').slick({
            slidesToShow: 6,
            slidesToScroll: 1,
            lazyLoad: 'ondemand',
            autoplay: true,
            autoplaySpeed: 2000,
            arrows: false,
            dots: false,
            infinite: true,
            responsive: [
                { breakpoint: 1200, settings: { slidesToShow: 5 } },
                { breakpoint: 992, settings: { slidesToShow: 4 } },
                { breakpoint: 768, settings: { slidesToShow: 3 } },
                { breakpoint: 480, settings: { slidesToShow: 2 } }
            ]
        });
    });
</script>
<style>
    .partners-section {
