@model VDCD.Models.CenterModelView
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@functions {
    // Hàm h? tr? l?y giá tr? nhanh và an toàn
    string GetSt(string key) => Model.Settings.ContainsKey(key) ? Model.Settings[key] : "";
}
<section class="hero-section d-flex align-items-end">
    <div class="container-fluid px-0">
        <div class="hero-content text-white p-5">
            
            <h1 data-aos="fade-right" data-aos-duration="600" class="display-3 fw-bold mb-0">@ViewData["Title"]</h1>
            <hr class="border-light opacity-50 mb-4" style="width:90%">
            <nav data-aos="fade-right" data-aos-duration="600" aria-label="breadcrumb">
                <ol class="breadcrumb mb-2">
                    <li class="breadcrumb-item"><a href="/" class="text-white text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active text-white fw-light" aria-current="page">H? th?ng trung tâm</li>
                </ol>
            </nav>
            
        </div>
    </div>
</section>
<style>
    .hero-section {
    /* Thay du?ng d?n ?nh c?a b?n vào dây */
    background-image: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.6)), url('/uploads/e9a9ef35-6e08-41e8-b8ea-7112e2a130f4_bg1.jpg');
    background-size: cover;
    background-position: center;
    height: 700px; /* Ði?u ch?nh chi?u cao tùy ý */
    position: relative;
    display: flex;
    align-items: flex-end; /* Ð?y n?i dung xu?ng dáy */
    margin-top: 45px;
}

.hero-content {
    width: 100%;
    background: linear-gradient(transparent, rgba(0,0,0,0.4)); /* Làm t?i nh? ph?n chân ch? */
    padding-bottom: 60px !important;
    padding-left: 10% !important;
}

.breadcrumb-item + .breadcrumb-item::before {
    content: ">";
    color: white;
}

.hero-content h1 {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    letter-spacing: -1px;
}

/* Responsive cho mobile */
@@media (max-width: 768px) {
    .hero-section {
        height: 350px;
    }
    .hero-content h1 {
        font-size: 2.5rem;
    }
}
</style>

<section class="centers-section py-5">
    <div class="container">
        <div class="col-12 text-center mb-5">
            <div data-aos="fade-down" data-aos-duration="600" class="d-flex justify-content-center align-items-center mb-4">
                <span class="line me-2" style="width: 30px; height: 2px; background-color: #e30613; display: inline-block;"></span>
                <span class="text-danger fw-bold text-uppercase small">h? sinh thái t?p doàn</span>
                <span class="line ms-2" style="width: 30px; height: 2px; background-color: #e30613; display: inline-block;"></span>
            </div>
            <h2 data-aos="fade-down" data-aos-duration="600" class="display-6 fw-bold text-uppercase">
                H? th?ng 12 trung tâm <br> Vi?n nghiên c?u tr?c thu?c
            </h2>
        </div>

        <div class="row g-4">
            @foreach (var center in Model.Centers)
            {
                <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-duration="600">
                    <div class="center-card h-100">
                        <div class="img-wrapper mb-3">
                            <img src="@center.Image" class="img-fluid rounded-0" alt="@center.Name" loading="lazy" width="400" height="225">
                        </div>

                        <div class="card-body">
                            <h4 class="fw-bold mb-3 center-title">@center.Name</h4>
                            <hr class="w-25 mb-3">
                            <a href="@center.Url" class="text-danger text-decoration-none fw-bold d-flex align-items-center learn-more">
                                <i class="bi bi-arrow-up-right me-2"></i> Tim Hi?u Thêm
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<style>
    /* Ðu?ng k? ngang màu d? c?nh text header */
    .red-line {
        display: inline-block;
        width: 40px;
        height: 2px;
        background-color: #dc3545;
    }

    /* Ð?nh d?ng tiêu d? trung tâm */
    .center-title {
        font-size: 1.5rem;
        line-height: 1.2;
        display: -webkit-box;
        -webkit-line-clamp: 2;      /* s? dòng mu?n hi?n th? */
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .center-card {
        border: 1px solid #eee;
		border-radius: 0 0 10px 10px;
		box-shadow: 3px 7px 8px #eee;
		height: 100%;
    }

    .card-body {
		padding: 0 10px 30px;
	}

    /* Hi?u ?ng cho ?nh */
    .img-wrapper {
        overflow: hidden;
        aspect-ratio: 16 / 9; /* Gi? t? l? ?nh chu?n */
    }

        .img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

    .center-card:hover img {
        transform: scale(1.05); /* Phóng to nh? khi hover */
    }

    /* Nút tìm hi?u thêm */
    .learn-more {
        font-size: 0.9rem;
        transition: gap 0.3s ease;
    }

        .center-card:hover .bi-arrow-up-right {
            transform: rotate(40deg);
            transition: 0.3s all;
        }

    /* Tùy ch?nh font ch? tiêu d? l?n */
    h2 {
        letter-spacing: -1px;
    }
</style>

<section class="collaboration-section py-5">
    <div class="container">
        <div class="col-12 text-center mb-5">
            <div data-aos="fade-down" data-aos-duration="600" class="d-flex justify-content-center align-items-center mb-4">
                <span class="line me-2" style="width: 30px; height: 2px; background-color: #e30613; display: inline-block;"></span>
                <span class="text-danger fw-bold text-uppercase small">cách th?c v?n hành</span>
                <span class="line ms-2" style="width: 30px; height: 2px; background-color: #e30613; display: inline-block;"></span>
            </div>
            <h2 data-aos="fade-down" data-aos-duration="600" class="display-6 fw-bold text-uppercase">
                @GetSt("setting.general.operation.main_title")
            </h2>
        </div>

        <div class="row mt-4">
            <div data-aos="fade-right" data-aos-duration="600" class="col-md-5 mb-4">
                <div class="sticky-top" style="top: 120px; z-index: 5;">
                    <div class="fixed-image-container shadow-sm">
                        <img id="operation-image" src="@GetSt("setting.general.operation.image.0")"
                             alt="Operation" loading="eager" width="500" height="500">
                    </div>
                </div>
            </div>

            <div data-aos="fade-left" data-aos-duration="600" class="col-md-7 ps-md-5">
                <div class="operation-timeline">
                    @{
                        int i = 0;
                        while (Model.Settings.ContainsKey($"setting.general.operation.title.{i}"))
                        {
                            var title = GetSt($"setting.general.operation.title.{i}");
                            var content = GetSt($"setting.general.operation.content.{i}");
                            var imageUrl = GetSt($"setting.general.operation.image.{i}");
                            var displayNum = (i + 1).ToString("D2");

                            <div class="timeline-item d-flex mb-5"
                                 onmouseover="changeOpImage('@imageUrl', this)">
                                <div class="timeline-number-wrapper me-4">
                                    <div class="timeline-number">@displayNum</div>
                                </div>
                                <div class="timeline-content">
                                    <h4 class="fw-bold h5">@title</h4>
                                    <p class="text-muted small">@content</p>
                                </div>
                            </div>
                            i++;
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<style>
    /* Khung ch?a ?nh c? d?nh */
    .fixed-image-container {
        width: 100%;
        /* B?n có th? ch?n t? l?: 1/1 (vuông), 4/3, ho?c 16/9 */
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background-color: #f8f9fa; /* Màu n?n ch? n?u ?nh l?i */
        border-radius: 4px;
    }

        .fixed-image-container img {
            width: 100%;
            height: 100%;
            /* Quan tr?ng nh?t: Giúp ?nh không b? méo, t? c?t t?a d? l?p d?y khung */
            object-fit: cover;
            object-position: center;
            transition: opacity 0.4s ease-in-out;
        }

    /* Tùy ch?nh cho Timeline d? mu?t hon */
    .operation-timeline::before {
        content: '';
        position: absolute;
        left: 35px; /* Ði?u ch?nh d? n?m dúng tâm vòng tròn s? */
        top: 10px;
        bottom: 50px;
        width: 1px;
        background-color: #dee2e6; /* Màu xám nh?t */
        z-index: -11;
    }

    .timeline-item {
        transition: all 0.3s;
        opacity: 0.5;
    }

        .timeline-item.active {
            opacity: 1;
        }

    .timeline-number {
        width: 50px;
        height: 50px;
     /*    border: 1px solid #dee2e6; */
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        z-index: -11;
        font-weight: bold;
    }

    .timeline-item.active .timeline-number {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
    }
</style>
<script>
    function changeOpImage(imgUrl, element) {
        const mainImg = document.getElementById('operation-image');

        // Ch? d?i n?u URL khác ?nh hi?n t?i
        if (mainImg.src !== imgUrl && imgUrl !== "") {
            mainImg.style.opacity = '0.3'; // M? d?n

            setTimeout(() => {
                mainImg.src = imgUrl;
                mainImg.style.opacity = '1'; // Hi?n rõ l?i
            }, 200);
        }

        // Active m?c dang ch?n
        document.querySelectorAll('.timeline-item').forEach(item => {
            item.classList.remove('active');
        });
        element.classList.add('active');
    }

    // Thi?t l?p m?c d?u tiên active khi load trang
    document.addEventListener("DOMContentLoaded", function () {
        const firstItem = document.querySelector('.timeline-item');
        if (firstItem) firstItem.classList.add('active');
    });
</script>
<section class="contact-section py-5 bg-light">
    <div class="container">
        <div class="mb-4">
            <div data-aos="fade-right" data-aos-duration="600" class="d-flex align-items-center mb-4">
                <span class="line me-2" style="width: 30px; height: 2px; background-color: #e30613; display: inline-block;"></span>
                <span class="text-danger fw-bold text-uppercase small">liên h?</span>
                <span class="line ms-2" style="width: 30px; height: 2px; background-color: #e30613; display: inline-block;"></span>
            </div>
            <h2 data-aos="fade-right" data-aos-duration="600" class="fw-bold display-6 text-uppercase">Liên h? v?i chúng tôi</h2>
        </div>

        <form class="contact-form mt-5" data-aos="fade-up" data-aos-duration="600">
            <div class="row g-4">
                <div class="col-md-6">
                    <input type="text" class="form-control-custom" placeholder="Tên *">
                </div>
                <div class="col-md-6">
                    <input type="text" class="form-control-custom" placeholder="S? Ði?n Tho?i *">
                </div>
                <div class="col-md-6">
                    <input type="email" class="form-control-custom" placeholder="Email *">
                </div>
                <div class="col-md-6">
                    <input type="text" class="form-control-custom" placeholder="Tiêu Ð? *">
                </div>
                <div class="col-12">
                    <textarea class="form-control-custom" rows="1" placeholder="N?i Dung *"></textarea>
                </div>
            </div>
            <button type="submit" class="btn-submit-circle mt-5">
                <span>G?i</span>
                <div class="icon-circle"><i class="bi bi-arrow-up-right"></i></div>
            </button>
        </form>
    </div>
</section>
<style>
    /* --- FIX ÐU?NG K? D?C --- */
   
    /* --- C? Ð?NH SIZE ?NH --- */
    .fixed-image-container {
        width: 100%;
        aspect-ratio: 1 / 1; /* C? d?nh hình vuông */
        overflow: hidden;
        border-radius: 4px;
    }

        .fixed-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* --- CONTACT FORM --- */
    .form-control-custom {
        width: 100%;
        background: transparent;
        border: none;
        border-bottom: 1px solid #dee2e6;
        padding: 15px 0;
        outline: none;
        transition: border-color 0.3s;
    }

        .form-control-custom:focus {
            border-bottom-color: #dc3545;
        }

    .btn-submit-circle {
        display: flex;
        align-items: center;
        background: #dc3545;
        color: #fff;
        border: 1px solid #dee2e6;
        border-radius: 50px;
        padding: 10px 10px 10px 35px;
        font-weight: bold;
        transition: all 0.3s;
        font-size: 20px;
    }

        .btn-submit-circle .icon-circle {
            width: 40px;
            height: 40px;
            background: rgb(255, 255, 255);
            color: #dc3545;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-left: 15px;
        }

    .btn-submit-circle:hover {
        background: #a11926;
        color: #fff;
    }

        .btn-submit-circle:hover .icon-circle {
            transform: rotate(45deg);
            transition: 0.3s all;
        }

    /* --- FOOTER --- */
    .social-btn {
        width: 45px;
        height: 45px;
        background: #1a1a1a;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border-radius: 4px;
        transition: background 0.3s;
    }

        .social-btn:hover {
            background: #dc3545;
            color: white;
        }
</style>