<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="facebook-domain-verification" content="hzvsk2ujlfe1ba7vs9tvtuur0x54ez" />
    <meta name="google-site-verification" content="Ob7yNe9gch26KTzxY3AadZmpxvIlRgGklyzONzeG-wQ" />
    @if (ViewData["NoIndex"] as bool? == true)
    {
        <meta name="robots" content="noindex, nofollow" />
    }

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  
    <link rel="stylesheet" type="text/css" href="~/Content/Home/slick.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="icon" href="/uploads/cbf7823d-e5f1-49fd-801a-8bf2253d4547_iconlogo.png" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" as="style" onload="this.onload=null;this.rel='stylesheet'">
    
</head>
<body id="top" style="margin-bottom:unset;">
    @await Html.PartialAsync("/Views/Shared/_PartialHeader.cshtml")
    <div class="container" style="margin: unset;max-width: unset;padding:unset">
        <main role="main" class="" style="padding-bottom:unset">
            @RenderBody()
        </main>
    </div>
    @await Html.PartialAsync("/Views/Shared/_PartialFooter.cshtml")

</body>

<script type="text/javascript" src="~/Script/jquery-3.6.0.min.js" defer></script>
<script type="text/javascript" src="~/Script/Home/slick.min.js" defer></script>
<script src="~/Script/bootstrap.bundle.min.js" defer></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js" defer></script>
<script>
  AOS.init();
</script>
</html>
